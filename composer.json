{
    "name": "bjornbasar/karhu-db",
    "description": "Thin PDO wrapper + active-record base for the karhu PHP microframework",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "phpstan/phpstan": "^2.0",
        "bjornbasar/karhu": "^0.1"
    },
    "autoload": {
        "psr-4": {
            "Karhu\\Db\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Karhu\\Db\\Tests\\": "tests/"
        }
    },
    "suggest": {
        "bjornbasar/karhu": "The karhu microframework (for UserRepositoryInterface)"
    },
    "config": {
        "sort-packages": true
    }
}
